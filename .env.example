# ============================================================================
# Barcode Monitor - local development environment example
# Copy to barcode-monitor/.env (or export these) and edit values as needed.
# NEVER commit a real .env file.
# ============================================================================

# --- PostgreSQL -----------------------------------------------------------------
# Preferred port is 5433. If your PostgreSQL listens elsewhere, change the port.
# The database is created by scripts/init_db.sh if missing.
DATABASE_URL=postgresql://barcode@localhost:5433/production_monitoring
# Fallback example using the existing Homebrew server on 5432:
# DATABASE_URL=postgresql://<your-os-user>@localhost:5432/production_monitoring

# --- Authentication -------------------------------------------------------------
# HMAC signing secret for local dev bearer tokens. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-dev-secret
# Token lifetime in seconds (default 8 hours)
TOKEN_TTL_SECONDS=28800

# --- Backend --------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins (CORS)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Generator / simulation -----------------------------------------------------
# Set to "false" to start with generation disabled (history is NOT deleted).
GENERATOR_ENABLED=true
GENERATOR_INTERVAL_MS=2500
GENERATOR_SUCCESS_RATE=0.92
# Number of scanners the generator simulates (SCANNER-01 .. SCANNER-NN)
SCANNER_COUNT=4
# Hours of synthetic history to seed on first empty-database initialization
SEED_HOURS=24
# Approximate events per hour during seeding (kept small for laptops)
SEED_EVENTS_PER_HOUR=120

# --- Display / timezone ---------------------------------------------------------
# Timezone used by the backend when returning timestamps and bucketing hours.
# Use an IANA name, e.g. Asia/Jakarta, UTC, Europe/London
DISPLAY_TZ=Asia/Jakarta

# --- Frontend (Vite) ------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events
